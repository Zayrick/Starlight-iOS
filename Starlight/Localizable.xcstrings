    },
    "The streaming protocol is based on moonlight-common-c from the Moonlight project. Starlight is an independent project and isn't affiliated with Moonlight, NVIDIA, or Sunshine." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "串流协议基于 Moonlight 项目的 moonlight-common-c。Starlight 是独立项目，与 Moonlight、NVIDIA 和 Sunshine 均无关联。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "串流協定基於 Moonlight 專案的 moonlight-common-c。Starlight 為獨立專案，與 Moonlight、NVIDIA 及 Sunshine 皆無關聯。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "串流協定以 Moonlight 項目的 moonlight-common-c 為基礎。Starlight 為獨立項目，與 Moonlight、NVIDIA 及 Sunshine 並無關連。"
          }
        }
      }
    },
