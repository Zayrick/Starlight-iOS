            "value" : "產生的證書無效。"
          }
        }
      }
    },
    "The host at this address has changed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该地址上的主机已发生变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此位址上的主機已變更。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此地址上的主機已變更。"
          }
        }
      }
    },
    "The host can only run one app at a time. Any unsaved progress will be lost." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机同一时间只能运行一个应用，未保存的进度将会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機一次只能執行一個 App，未儲存的進度將會遺失。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機每次只能執行一個 App，未儲存的進度將會遺失。"
          }
        }
      }
    },
    "The host declined the pairing request." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机拒绝了配对请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機拒絕了配對要求。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機拒絕了配對請求。"
          }
        }
      }
    },
    "The host emulates a PlayStation controller, so games can use motion and the touchpad." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机会模拟 PlayStation 手柄，游戏可以使用体感和触摸板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機會模擬 PlayStation 控制器，遊戲可使用動作感應與觸控板。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機會模擬 PlayStation 手掣，遊戲可使用體感及觸控板。"
          }
        }
      }
    },
    "The host emulates an Xbox controller, which works with the most games." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机会模拟 Xbox 手柄，兼容的游戏最多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機會模擬 Xbox 控制器，相容的遊戲最多。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機會模擬 Xbox 手掣，兼容的遊戲最多。"
          }
        }
      }
    },
    "The host emulates the same kind of controller you're using, or picks one itself if it can't tell." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机会模拟与你所用手柄相同类型的手柄，无法识别时由主机决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機會模擬與你所用相同類型的控制器，無法辨識時由主機決定。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機會模擬與你所用相同類型的手掣，無法辨識時由主機決定。"
          }
        }
      }
    },
    "The host is offline. Make sure it's turned on and on the same network as this device." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机当前离线。请确认主机已开机，并与本设备连接到同一网络。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機目前離線。請確認主機已開機，並與此裝置連接至同一個網路。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
