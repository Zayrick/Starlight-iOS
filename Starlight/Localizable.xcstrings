    "The Command key is kept for shortcuts on this device and isn't sent to the host." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command 键保留给本机快捷键，不会发送到主机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
