    "YUV 4:4:4 uses HEVC for sharper text but needs a higher bitrate. It falls back to 4:2:0 if the host doesn't support it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YUV 4:4:4 使用 HEVC 编码，文字更清晰，但需要更高码率；主机不支持时会回退到 4:2:0。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YUV 4:4:4 使用 HEVC 編碼，文字更清晰，但需要更高的位元率；若主機不支援，會改用 4:2:0。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YUV 4:4:4 使用 HEVC 編碼，文字更清晰，但需要較高位元率；如主機不支援，會改用 4:2:0。"
          }
        }
      }
    },
