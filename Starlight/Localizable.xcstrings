            "state" : "translated",
            "value" : "連接意外中斷（錯誤 %lld）。"
          }
        }
      }
    },
    "The content on the host is protected and can't be streamed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机上的内容受保护，无法串流。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機上的內容受保護，無法串流。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機上的內容受保護，無法串流。"
          }
        }
      }
    },
    "The generated certificate isn't valid." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成的证书无效。"
          }
        },
        "zh-Hant" : {
